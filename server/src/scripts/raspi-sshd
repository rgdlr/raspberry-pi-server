#!/usr/bin/env bash

TARGET_USER="${SUDO_USER:-$(whoami)}"
USER_HOME=$(eval echo "~$TARGET_USER")
AUTH_KEYS_COUNT=$(grep -c "^[a-zA-Z]" "$USER_HOME/.ssh/authorized_keys" 2>/dev/null || echo 0)

echo " ⏳ Configuring SSH daemon..."

# Backup sshd_config
[ ! -f /etc/ssh/sshd_config.bak ] && sudo cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak

# Determine PasswordAuthentication setting safely
DISABLE_PASSWORDS="yes"
if [ "$AUTH_KEYS_COUNT" -eq 0 ]; then
    echo " ⚠️  No authorized keys found. Disabling passwords would lock you out!"
    echo "    Password authentication will remain ENABLED until keys are verified."
    DISABLE_PASSWORDS="no"
else
    read -r -p " ❔ Disable password login and enforce SSH keys? (y/n) [default: y]: " DIS_PASS
    [ -z "$DIS_PASS" ] && DIS_PASS="y"
    if [ "$DIS_PASS" != "y" ] && [ "$DIS_PASS" != "Y" ]; then
        DISABLE_PASSWORDS="no"
    fi
fi

# Create dedicated drop-in hardening config in sshd_config.d or update main file
CONF_FILE="/etc/ssh/sshd_config.d/99-raspi-server.conf"

sudo bash -c "cat <<EOF > '$CONF_FILE'
# Raspberry Pi Server Hardening Configuration
Port 22022
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication $( [ "$DISABLE_PASSWORDS" == "yes" ] && echo "no" || echo "yes" )
KbdInteractiveAuthentication $( [ "$DISABLE_PASSWORDS" == "yes" ] && echo "no" || echo "yes" )
UsePAM yes
StrictModes yes
MaxAuthTries 3
ClientAliveInterval 300
ClientAliveCountMax 3
X11Forwarding no
AllowUsers $TARGET_USER
EOF"

sudo chmod 644 "$CONF_FILE"

# Test configuration syntax before reloading daemon
if sudo sshd -t; then
    echo " ✅ SSH configuration syntax verified."
    echo " ⏳ Restarting SSH service on port 22022..."
    sudo systemctl restart ssh 2>/dev/null || sudo systemctl restart sshd 2>/dev/null
    echo " ✅ SSH service restarted on port 22022."
    echo "    ℹ️  Connect with: ssh -p 22022 $TARGET_USER@<ip-or-domain>"
else
    echo " ❌ SSH configuration test failed! Reverting changes..."
    sudo rm -f "$CONF_FILE"
    exit 1
fi

