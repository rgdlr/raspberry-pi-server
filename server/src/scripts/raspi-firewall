#!/usr/bin/env bash

# Install firewall if not present
echo " ⏳ Installing and configuring UFW firewall..."
if ! which ufw >/dev/null 2>&1; then
    sudo apt-get update -y >/dev/null 2>&1
    sudo apt-get install ufw -y >/dev/null 2>&1
fi
echo " ✅ Firewall package installed"

# Configure firewall rules
echo " ⏳ Setting firewall policies and rules..."
sudo ufw default deny incoming >/dev/null 2>&1
sudo ufw default allow outgoing >/dev/null 2>&1

# Allow hardened SSH port (22022) with rate-limiting to prevent brute force
sudo ufw limit 22022/tcp comment 'Hardened SSH' >/dev/null 2>&1

# Allow standard SSH port (22) temporarily as fallback during migration
sudo ufw limit 22/tcp comment 'Standard SSH' >/dev/null 2>&1

# Allow HTTP and HTTPS for web server
sudo ufw allow 80/tcp comment 'HTTP (Nginx/Certbot)' >/dev/null 2>&1
sudo ufw allow 443/tcp comment 'HTTPS (Nginx)' >/dev/null 2>&1

# Note: Backend port 44380 is intentionally NOT exposed externally
# It is accessed via reverse proxy from Nginx on localhost (127.0.0.1:44380)

# Enable firewall non-interactively
sudo ufw --force enable >/dev/null 2>&1
echo " ✅ Firewall active and configured"
sudo ufw status verbose

