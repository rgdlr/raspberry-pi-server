#!/usr/bin/env bash

# Interactive TUI Setup Tool for Raspberry Pi Server

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

function raspi-menu {
    SELECTION=$(
        whiptail \
            --title "Raspberry Pi Setup & Tools" \
            --menu "Select an administrative action" 22 80 12 \
                "Config"      "Launch official raspi-config tool" \
                "Update"      "Update & upgrade all system packages" \
                "Static IP"   "Configure static network IP address" \
                "SSH Keys"    "Configure SSH keypairs and authorized keys" \
                "SSH Hardening" "Harden SSH daemon (port 22022, disable password)" \
                "Firewall"    "Configure and enable UFW firewall" \
                "Public IP"   "Display current public WAN IP address" \
                "Banner"      "Display diagnostics MOTD banner" \
                "Full Setup"  "Run full automated server provisioning" \
                "Exit"        "Quit this menu" 3>&1 1>&2 2>&3
    )

    STATUS=$?
    if [ $STATUS -ne 0 ] || [ "$SELECTION" == "Exit" ]; then
        clear
        exit 0
    fi

    clear
    case $SELECTION in
        "Config")
            sudo raspi-config
            ;;
        "Update")
            bash "$SCRIPTS_ROOT/raspi-update"
            ;;
        "Static IP")
            bash "$SCRIPTS_ROOT/raspi-static"
            ;;
        "SSH Keys")
            bash "$SCRIPTS_ROOT/raspi-sshkeys"
            ;;
        "SSH Hardening")
            bash "$SCRIPTS_ROOT/raspi-sshd"
            ;;
        "Firewall")
            bash "$SCRIPTS_ROOT/raspi-firewall"
            ;;
        "Public IP")
            bash "$SCRIPTS_ROOT/misc/raspi-network"
            ;;
        "Banner")
            bash "$SCRIPTS_ROOT/raspi-banner"
            ;;
        "Full Setup")
            bash "$SCRIPTS_ROOT/config/raspi-server"
            ;;
    esac
    echo ""
    read -r -p "Press Enter to return to menu..." _
}

while true; do
    raspi-menu
done

