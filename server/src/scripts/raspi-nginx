#!/usr/bin/env bash

# Check DDNS_URL
if [ -z "$DDNS_URL" ]; then
    read -r -p " ❔ Enter your domain / DDNS URL (or press Enter for default IP host): " USER_DOMAIN
    if [ -n "$USER_DOMAIN" ]; then
        DDNS_URL="$USER_DOMAIN"
        export DDNS_URL
    else
        DDNS_URL="_"
    fi
fi

SITE_NAME="${DDNS_URL:-default}"
[ "$SITE_NAME" == "_" ] && SITE_NAME="raspberry"

echo " ⏳ Installing Nginx web server..."
sudo apt-get update -y >/dev/null 2>&1
sudo apt-get install nginx -y >/dev/null 2>&1
echo " ✅ Nginx installed"

# Create webroot folder for frontend assets
WEB_ROOT="/var/www/$SITE_NAME"
echo " ⏳ Preparing web root at $WEB_ROOT..."
sudo mkdir -p "$WEB_ROOT"
CURRENT_USER="${SUDO_USER:-$(whoami)}"
sudo chown -R "$CURRENT_USER:www-data" "$WEB_ROOT"
sudo chmod 755 "$WEB_ROOT"

# Create fallback index.html if empty
if [ ! -f "$WEB_ROOT/index.html" ]; then
    cat <<EOF > "$WEB_ROOT/index.html"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raspberry Pi Server</title>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; background: #121212; color: #f0f0f0; display: grid; place-content: center; height: 100vh; margin: 0; text-align: center; }
        h1 { color: #2ecc71; margin-bottom: 0.5rem; }
        p { color: #888; }
        a { color: #3498db; text-decoration: none; font-weight: bold; }
    </style>
</head>
<body>
    <h1>🍓 Raspberry Pi Server</h1>
    <p>Web server configured successfully. Deploy frontend build to activate monitoring UI.</p>
    <p><a href="/api/v1">Explore REST API &rarr;</a></p>
</body>
</html>
EOF
fi
echo " ✅ Web root ready"

# Generate Nginx Virtual Host configuration (idempotent, overwriting rather than appending)
SERVER_NAMES="$DDNS_URL"
if [ "$DDNS_URL" != "_" ] && [ "$DDNS_URL" != "localhost" ]; then
    SERVER_NAMES="$DDNS_URL www.$DDNS_URL"
fi

CONF_FILE="/etc/nginx/sites-available/$SITE_NAME"
echo " ⏳ Writing Nginx virtual host to $CONF_FILE..."

sudo bash -c "cat <<EOF > '$CONF_FILE'
server {
    listen 80;
    listen [::]:80;

    server_name $SERVER_NAMES;

    # Frontend Single Page Application (SPA)
    location / {
        root $WEB_ROOT;
        index index.html;
        try_files \\\$uri \\\$uri/ /index.html;
        add_header Cache-Control 'no-store, no-cache, must-revalidate';
    }

    # Static assets caching
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root $WEB_ROOT;
        expires 30d;
        add_header Cache-Control 'public, no-transform';
    }

    # REST API Reverse Proxy to Express backend
    location /api/v1 {
        proxy_pass http://127.0.0.1:44380;
        proxy_http_version 1.1;
        proxy_set_header Host \\\$host;
        proxy_set_header X-Real-IP \\\$remote_addr;
        proxy_set_header X-Forwarded-For \\\$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \\\$scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}
EOF"

# Enable configuration and disable default
sudo ln -sf "$CONF_FILE" "/etc/nginx/sites-enabled/$SITE_NAME"
[ -f /etc/nginx/sites-enabled/default ] && sudo rm -f /etc/nginx/sites-enabled/default

# Validate configuration before reload
if sudo nginx -t >/dev/null 2>&1; then
    sudo systemctl restart nginx
    echo " ✅ Nginx configured and restarted successfully."
else
    echo " ❌ Nginx configuration test failed! Please inspect syntax."
    sudo nginx -t
    exit 1
fi

